generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  brandProfile  BrandProfile?
  projects      Project[]
  campaigns     Campaign[]
  ideas         ContentIdea[]
  posts         Post[]
  approvals     Approval[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BrandProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  professionalTitle     String
  bioSummary            String   @db.Text
  primaryGoal           String   @default("CAREER_AND_FREELANCE")
  coreSkills            String[]
  targetRoles           String[]
  freelanceServices     String[]
  toneOfVoice           String   @db.Text
  targetAudienceSummary String   @db.Text
  contentPillars        String[]
  languages             String[] @default(["English"])
  portfolioUrl          String?
  githubUrl             String?
  linkedinUrl           String?
  twitterUrl            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id                   String        @id @default(cuid())
  userId               String
  title                String
  slug                 String
  projectContext       String
  problemStatement     String        @db.Text
  solutionArchitecture String        @db.Text
  techStack            String[]
  businessImpact       String        @db.Text
  keyMetrics           String[]
  constraintsFaced     String        @db.Text
  lessonsLearned       String        @db.Text
  projectUrl           String?
  repositoryUrl        String?
  completedAt          DateTime?
  isFeatured           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideas ContentIdea[]

  @@unique([userId, slug])
}

model Campaign {
  id          String        @id @default(cuid())
  userId      String
  name        String
  objective   String        @db.Text
  startDate   DateTime?
  endDate     DateTime?
  status      String        @default("PLANNING")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ideas ContentIdea[]
  posts Post[]
}

model ContentIdea {
  id             String    @id @default(cuid())
  userId         String
  projectId      String?
  campaignId     String?
  title          String
  hook           String    @db.Text
  targetAudience String
  contentPillar  String
  targetPlatform String    @default("ALL")
  status         String    @default("IDEA")
  sourceNotes    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  posts    Post[]
}

model Post {
  id           String        @id @default(cuid())
  userId       String
  ideaId       String?
  campaignId   String?
  title        String
  status       String        @default("DRAFT")
  scheduledFor DateTime?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea      ContentIdea?  @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  campaign  Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  versions  PostVersion[]
  approvals Approval[]
}

model PostVersion {
  id             String   @id @default(cuid())
  postId         String
  platform       String
  content        String   @db.Text
  hashtags       String[]
  visualPrompt   String?  @db.Text
  carouselSlides Json?
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, platform])
}

model Approval {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  decision  String
  feedback  String?  @db.Text
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
